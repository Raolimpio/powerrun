# ⚠️ EXEMPLO - NÃO COMMITAR ESTE ARQUIVO COM VALORES REAIS

# Este arquivo serve como referência para configurar os GitHub Secrets
# Copie os nomes das variáveis e configure-as em:
# Settings → Secrets and variables → Actions → New repository secret

# =============================================================================
# 🗃️ DATABASE
# =============================================================================
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco

# =============================================================================
# 🔐 AUTHENTICATION
# =============================================================================
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://seu-dominio.com

# =============================================================================
# ☁️ CLOUDINARY
# =============================================================================
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# =============================================================================
# 🏢 INFORMAÇÕES DA EMPRESA
# =============================================================================
NEXT_PUBLIC_COMPANY_WHATSAPP=5511999999999
NEXT_PUBLIC_COMPANY_EMAIL=contato@powerrun.com
NEXT_PUBLIC_COMPANY_PHONE=+55 11 9999-9999
NEXT_PUBLIC_COMPANY_NAME=Power Run
NEXT_PUBLIC_COMPANY_ADDRESS=Endereço completo da empresa

# =============================================================================
# 🗺️ GOOGLE MAPS
# =============================================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# =============================================================================
# 📊 SENTRY (Opcional - para monitoramento de erros)
# =============================================================================
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# =============================================================================
# 🚀 VERCEL (Para deploy preview automático)
# =============================================================================
# Obter em: https://vercel.com/account/tokens
VERCEL_TOKEN=

# Obter executando: vercel link
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# =============================================================================
# ⚙️ CONFIGURAÇÕES OPCIONAIS
# =============================================================================

# Modo de desenvolvimento
NODE_ENV=production

# Configuração de SEO
SEO_MAX_MODE=false

# Admin Password Hash
# Gerar com: node scripts/hash-password.js sua-senha
ADMIN_PASSWORD_HASH=

