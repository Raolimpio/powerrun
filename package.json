{
  "name": "powerrun",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run type-check && npm test",
    "validate:ci": "node scripts/validate-ci-config.js",
    "generate:cities": "node scripts/generate-static-cities.cjs",
    "export:cities:json": "npx tsx scripts/export-cities-to-json.ts",
    "add:gps": "npx tsx scripts/add-gps-coordinates.ts",
    "merge:gps": "npx tsx scripts/merge-gps-to-cities.ts",
    "gps:full": "npm run export:cities:json && npm run add:gps && npm run merge:gps",
    "prisma:generate": "dotenv -e .env.local -- prisma generate",
    "prisma:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "prisma:studio": "dotenv -e .env.local -- prisma studio",
    "prisma:push": "dotenv -e .env.local -- prisma db push",
    "prisma:validate": "prisma validate",
    "admin:init": "node scripts/init-admin.cjs",
    "send-report": "npx tsx scripts/send-marketing-report.ts",
    "test:sitemaps:blue-line": "npx tsx scripts/test-blue-line-sitemaps-local.ts",
    "submit:sitemaps:google": "npx tsx scripts/submit-sitemaps-to-google.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@sentry/nextjs": "^10.28.0",
    "@types/nodemailer": "^7.0.4",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "fuse.js": "^7.1.0",
    "googleapis": "^167.0.0",
    "lucide-react": "^0.555.0",
    "next": "^15.5.7",
    "next-intl": "^4.5.7",
    "nodemailer": "^7.0.11",
    "react": "18.3.1",
    "react-datepicker": "^8.10.0",
    "react-dom": "18.3.1",
    "recharts": "^3.5.1",
    "tailwind-merge": "^3.4.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "18.3.12",
    "@types/react-datepicker": "^6.2.0",
    "@types/react-dom": "18.3.1",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.22",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "^8.4.0",
    "prettier": "^3.7.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.3.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "overrides": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1"
  }
}
